# --- Required ---
# Your Discord bot token (Discord Developer Portal > your app > Bot > Reset Token).
DISCORD_TOKEN=paste-your-bot-token-here

# --- Channels ---
# Turn on Developer Mode in Discord (User Settings > Advanced), then right-click a
# channel and choose "Copy Channel ID".
#
# Channel for the per-poll summary and routine server events (joins, leaves, renames):
EVENTS_CHANNEL_ID=
# Channel for heartbeat-counter anomaly alerts.
# Leave blank to reuse EVENTS_CHANNEL_ID, or set a separate channel to keep them apart.
INTEGRITY_CHANNEL_ID=

# --- Optional ---
# Set this to your Discord server's ID for instant slash-command updates while
# testing. Leave blank to register commands globally (can take up to 1 hour).
GUILD_ID=

# How often to poll the master server, in minutes. Polling every minute records
# a data point even when the list has not changed, so any unexpected change is
# captured within a minute.
POLL_INTERVAL_MINUTES=1

# Master server list endpoint. The default is the official Attorney Online
# master server; leave it as-is for normal use. To track your own community
# instead, point this at any URL that returns the AO master-list JSON array
# (your own master server, a generated/static JSON file, or a proxy of the
# official list). See "Using your own master list and WebAO" in the README.
#
# To poll more than one master at once, list several URLs separated by commas.
# Their server lists are merged and deduplicated by ip:port, and a master that
# is unreachable is skipped without blacking out the others. For example:
#   MS_URL=https://servers.aceattorneyonline.com/servers,https://my-master.example/servers
#
# By default the bot polls both the official Attorney Online master server and
# our open-source master server (servers.umineko.online), powered by
# Nyan-AO-Master-Server -- see the README. Remove the second URL to poll only
# the official list.
MS_URL=https://servers.aceattorneyonline.com/servers,https://servers.umineko.online/servers

# --- Umineko Online master rules ---
# The Umineko Online master (Nyan-AO-Master-Server) behaves differently from
# the vanilla Attorney Online master: its hbcounter is clock-anchored, climbs
# smoothly ~1/min, caps at 10080 and rolls over to 9000. The bot analyses and
# labels anomalies for it with a separate rule profile, so its alerts stay
# clearly distinct from vanilla AO alerts even when they share a channel.
#
# Any master URL listed here is treated as Umineko-style; every other master
# uses the vanilla rules. Defaults to the public Umineko master. List several
# URLs separated by commas if you run more than one Umineko-style master.
MS_UMINEKO_URL=https://servers.umineko.online/servers
# The hbcounter cap and rollover drop the Umineko master uses. Only change
# these if you run a custom Umineko master with non-default MS_HBCOUNTER_CAP /
# MS_HBCOUNTER_ROLLOVER_DROP settings.
MS_UMINEKO_HBCOUNTER_CAP=10080
MS_UMINEKO_HBCOUNTER_ROLLOVER_DROP=1080
# How long the Umineko master keeps a silent server listed before it goes
# stale (its MS_HEARTBEAT_EXPIRY_MINUTES). The counter only advances when a
# heartbeat arrives, so a server that goes quiet and resumes within this
# window legitimately leaps by up to this many minutes in one step -- the
# bot's heartbeat-jump tolerance is sized from this so resumed servers are
# not mistaken for tampering. Match it to your Umineko master's setting.
MS_UMINEKO_HEARTBEAT_EXPIRY_MINUTES=60

# How many days a server may be absent from the master list before /deadservers
# treats it as shut down. Stored history is never deleted, so a server that
# re-pings the list after this window simply drops off the dead list again.
DEAD_SERVER_DAYS=60

# Where the database and logs are stored.
DATA_DIR=data

# --- Bot-pattern detection ---
# The bot watches every server's player count for shapes that organic
# traffic never produces. Anything flagged is logged AND its inflated
# count is substituted out of stored snapshots / poll totals (the raw
# value is preserved in snapshots.players_raw for review). The detector
# is tuned to let popular servers grow organically without false flags
# while still catching obvious bot fills. See README "Bot-pattern
# detection" for the full rules. Every knob below ships with the
# defaults the bot was tuned for -- leave a value blank to keep its
# default, or override it to retune detection without a code change.
#
# Burst: the classic "near-empty server suddenly filled" check.
# BOT_SPIKE_MIN     players needed for a burst to qualify
# BOT_SPIKE_MAX     top of the typical bot-fill band (above this the
#                   alert message notes it cleared the band)
# BOT_BASELINE_MAX  a server whose recent median is at or below this is
#                   "normally empty" and eligible for burst detection;
#                   raise it to be more eager, lower it to be stricter
# BOT_SPIKE_POLLS   how many polls the burst must appear within
# BOT_BASELINE_WINDOW  how many recent snapshots define the baseline
#                      (~30 minutes at the default 1-minute poll)
BOT_SPIKE_MIN=40
BOT_SPIKE_MAX=100
BOT_BASELINE_MAX=8
BOT_SPIKE_POLLS=2
BOT_BASELINE_WINDOW=30
#
# Plateau: identical non-trivial count held across this many polls is a
# bot tell (real activity always wobbles by 1-2 every minute).
BOT_PLATEAU_POLLS=8
BOT_PLATEAU_MIN=20
# Instant max-out: previous poll was at or below this when the current
# poll already crossed BOT_SPIKE_MIN -- no organic ramp.
BOT_INSTANT_MAX_BASELINE=1
# Implausibly large burst: numbers above this on a normally near-empty
# server do not happen organically; reported as an alert regardless.
BOT_IMPLAUSIBLE_MIN=200
# Ramp guard: if the previous poll was already this fraction of the
# current count, treat as organic growth and skip the burst alert
# (obvious tells still fire).
BOT_RAMP_RATIO=0.5
# Popular-server lenience: a server with an all-time peak at or above
# BOT_POPULAR_PEAK_MIN gets its burst threshold scaled to
# peak * BOT_POPULAR_BURST_FACTOR, so regular crowds never re-flag.
BOT_POPULAR_PEAK_MIN=25
BOT_POPULAR_BURST_FACTOR=2.0
# Cross-server context. When the network's median peer count is at or
# above BOT_BUSY_NETWORK_MEDIAN this poll, the bot treats one server
# rising along with the rest as part of an event, not a bot fill.
# Conversely, the same exact non-trivial count appearing on
# BOT_COPYCAT_MIN_PEERS+ other servers (each at least
# BOT_COPYCAT_MIN_COUNT) is escalated as a coordinated fill.
BOT_BUSY_NETWORK_MEDIAN=15
BOT_COPYCAT_MIN_PEERS=2
BOT_COPYCAT_MIN_COUNT=10

# --- Website / live dashboard ---
# Set WEBSITE_ENABLED=1 to also run a live web dashboard alongside the bot.
# It runs in the same process, reads the same database, and shows every
# server, the global player count, anomalies and per-server history in your
# browser -- no Discord needed. Leave blank/0 to keep it off.
WEBSITE_ENABLED=0
# Address and port the dashboard listens on. 0.0.0.0 = reachable from other
# machines; use 127.0.0.1 to keep it local-only. Then open http://HOST:PORT.
WEBSITE_HOST=0.0.0.0
WEBSITE_PORT=8080
# Shown in the dashboard header -- name it whatever you like.
WEBSITE_TITLE=AO-MS-BOT Dashboard

# --- WebAO join links ---
# WebAO client host used to build "join in browser" links for each server.
# No scheme needed -- http:// or https:// is chosen automatically to match the
# server's ws / wss port. The default is the webao.miku.pizza fork.
WEBAO_CLIENT=webao.miku.pizza/client.html
