# --- Required ---
# Your Discord bot token (Discord Developer Portal > your app > Bot > Reset Token).
DISCORD_TOKEN=paste-your-bot-token-here

# --- Channels ---
# Turn on Developer Mode in Discord (User Settings > Advanced), then right-click a
# channel and choose "Copy Channel ID".
#
# Channel for routine server events (servers joining/leaving, renames, new servers):
EVENTS_CHANNEL_ID=
# Channel for heartbeat-counter anomaly alerts.
# Leave blank to reuse EVENTS_CHANNEL_ID, or set a separate channel to keep them apart.
INTEGRITY_CHANNEL_ID=

# --- Optional ---
# Set this to your Discord server's ID for instant slash-command updates while
# testing. Leave blank to register commands globally (can take up to 1 hour).
GUILD_ID=

# How often to poll the master server, in minutes. Polling every minute records
# a data point even when the list has not changed, so any unexpected change is
# captured within a minute.
POLL_INTERVAL_MINUTES=1

# Master server list endpoint (no need to change this).
MS_URL=https://servers.aceattorneyonline.com/servers

# Where the database and logs are stored.
DATA_DIR=data
